#!/usr/bin/env bash
# Every check maitred's CI runs, in the same order, so local and CI never disagree.
# Usage: bin/check
set -euo pipefail

cd "$(dirname "$0")/.."

need() {
  command -v "$1" >/dev/null || { echo "bin/check: $1 is not installed (see ARCHITECTURE.md, Build order, phase 0)" >&2; exit 1; }
}
step() { printf '\n== %s\n' "$*"; }

need cargo-deny
need cargo-llvm-cov
need cargo-machete
need cargo-nextest

step "format"
cargo fmt --all --check

step "lints"
cargo clippy --workspace --all-targets --locked -- -D warnings

step "dependencies (licences, sources, duplicates, bans, advisories)"
cargo deny --locked check

step "unused dependencies"
cargo machete

step "durations live in the config"
# ARCHITECTURE.md, Test kit, Time: no bare duration literal outside a config module. The test kit's
# own timeouts are test timing, not maitred's config, and live in its one timing.rs.
if offenders=$(grep -rnE 'Duration::from_(secs|millis|micros|nanos|secs_f32|secs_f64)\(' crates --include='*.rs' \
  | grep -vE '/(config|config/[^:]*)\.rs:' \
  | grep -vE '^crates/maitred-testkit/src/timing\.rs:' ); then
  echo "$offenders"
  echo "bin/check: a duration literal outside the config module; name it in the config instead" >&2
  exit 1
fi

step "tests, and coverage: every line, region and function of maitred-core runs in a test"
# One instrumented run of the whole workspace's tests, with the report limited to maitred-core's product
# code. Counts, not percentages, so rounding can't hide one. Branch coverage needs a nightly compiler, so
# it has its own job (bin/coverage-branches); mutants run in a memory-capped container (bin/mutants).
# Each toolchain builds into its own directory: llvm-cov reads every binary it finds, and one built by
# another compiler shows its code as never run.
CARGO_LLVM_COV_TARGET_DIR="target/llvm-cov-$(rustc --version | cut -d' ' -f2)" \
  cargo llvm-cov nextest --workspace --locked --no-tests=pass --summary-only \
  --ignore-filename-regex '/(tests|props)\.rs$|/testgen\.rs$|crates/maitred(-scenario|-testkit|-sim)?/' \
  --fail-uncovered-lines 0 --fail-uncovered-regions 0 --fail-uncovered-functions 0

step "docs"
RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --locked

printf '\nbin/check: all green\n'
